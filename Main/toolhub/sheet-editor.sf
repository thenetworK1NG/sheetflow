{
  "format": "sheetflow-tool",
  "version": 1,
  "tool": {
    "id": "sheet-editor",
    "name": "Sheet Editor",
    "icon": "✎",
    "description": "Click any cell to edit its value directly. Tab moves to the next cell.",
    "author": "Sheetflow",
    "version": "1.0.0",
    "code": "registerTool({\n  id: \"sheet-editor\",\n  name: \"Sheet Editor\",\n  icon: \"\\u270E\",\n  description: \"Click any cell to edit its value directly.\",\n\n  _boundHandler: null,\n\n  activate() {\n    this._boundHandler = this._onCellClick.bind(this);\n    refs.tableBody.addEventListener(\"click\", this._boundHandler);\n  },\n\n  deactivate() {\n    if (this._boundHandler) {\n      refs.tableBody.removeEventListener(\"click\", this._boundHandler);\n      this._boundHandler = null;\n    }\n  },\n\n  _onCellClick(event) {\n    if (!state.activeToolIds.has(\"sheet-editor\")) return;\n    const td = event.target.closest(\"[data-cell-row]\");\n    if (!td || event.target.closest(\"button, input, select\")) return;\n    if (td.querySelector(\"input\")) return;\n\n    const sheet = currentSheet();\n    if (!sheet) return;\n\n    const rowId = td.dataset.cellRow;\n    const colIndex = Number(td.dataset.cellColumn);\n    const row = sheet.rows.find((r) => r.id === rowId);\n    if (!row) return;\n\n    const originalValue = valueToString(row.values[colIndex]);\n    const input = document.createElement(\"input\");\n    input.type = \"text\";\n    input.className = \"cell-editor\";\n    input.value = originalValue;\n\n    td.textContent = \"\";\n    td.appendChild(input);\n    input.focus();\n    input.select();\n\n    function commit() {\n      const newValue = input.value;\n      row.values[colIndex] = newValue;\n      row.searchText = row.values.map(normalizeText).join(\" \");\n      const span = document.createElement(\"span\");\n      span.className = \"cell-value\";\n      if (newValue === \"\") {\n        const empty = document.createElement(\"span\");\n        empty.className = \"cell-empty\";\n        empty.textContent = \"<empty>\";\n        span.appendChild(empty);\n      } else {\n        span.textContent = newValue;\n      }\n      td.textContent = \"\";\n      td.appendChild(span);\n      refresh();\n    }\n\n    function cancel() {\n      const span = document.createElement(\"span\");\n      span.className = \"cell-value\";\n      if (originalValue === \"\") {\n        const empty = document.createElement(\"span\");\n        empty.className = \"cell-empty\";\n        empty.textContent = \"<empty>\";\n        span.appendChild(empty);\n      } else {\n        span.textContent = originalValue;\n      }\n      td.textContent = \"\";\n      td.appendChild(span);\n    }\n\n    input.addEventListener(\"blur\", commit);\n    input.addEventListener(\"keydown\", (e) => {\n      if (e.key === \"Enter\") {\n        e.preventDefault();\n        input.blur();\n      } else if (e.key === \"Escape\") {\n        e.preventDefault();\n        input.removeEventListener(\"blur\", commit);\n        cancel();\n      } else if (e.key === \"Tab\") {\n        e.preventDefault();\n        input.removeEventListener(\"blur\", commit);\n        const newValue = input.value;\n        row.values[colIndex] = newValue;\n        row.searchText = row.values.map(normalizeText).join(\" \");\n        const span = document.createElement(\"span\");\n        span.className = \"cell-value\";\n        if (newValue === \"\") {\n          const empty = document.createElement(\"span\");\n          empty.className = \"cell-empty\";\n          empty.textContent = \"<empty>\";\n          span.appendChild(empty);\n        } else {\n          span.textContent = newValue;\n        }\n        td.textContent = \"\";\n        td.appendChild(span);\n        const allCells = Array.from(refs.tableBody.querySelectorAll(\"td[data-cell-row]\"));\n        const currentIndex = allCells.indexOf(td);\n        const nextCell = e.shiftKey ? allCells[currentIndex - 1] : allCells[currentIndex + 1];\n        if (nextCell) {\n          const mouseEvent = new MouseEvent(\"click\", { bubbles: true, cancelable: true });\n          nextCell.dispatchEvent(mouseEvent);\n        }\n      }\n    });\n  }\n});"
  }
}