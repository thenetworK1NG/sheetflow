{
  "format": "sheetflow-tool",
  "version": 1,
  "tool": {
    "id": "row-filter-builder",
    "name": "Row Filter Builder",
    "icon": "🔍",
    "description": "Build complex multi-condition filters to show or hide rows based on any combination of rules.",
    "author": "Sheetflow",
    "version": "1.0.0",
    "code": "var _rfb = { conditions: [], logicMode: \"and\", _panel: null, _sidebar: null, _btn: null };\n\nvar _rfbStyle = document.createElement(\"style\");\n_rfbStyle.textContent = \".rfb-panel{margin:18px 0;border:1px solid #e4e7ec;border-radius:14px;background:#fff;box-shadow:0 7px 20px rgba(16,24,40,.05)}.rfb-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:19px 21px 16px;border-bottom:1px solid #e4e7ec}.rfb-head-actions{display:flex;align-items:center;flex-wrap:wrap;justify-content:flex-end;gap:7px}.rfb-body{padding:13px 21px 15px}.rfb-empty{padding:17px 14px;border:1px dashed #cfd5dd;border-radius:7px;color:#667085;background:#f8fafc;font-size:12px}.rfb-condition{display:grid;grid-template-columns:auto 1fr 1fr 1fr auto;align-items:center;gap:8px;padding:9px 10px;border:1px solid #e4e7ec;border-radius:7px;background:#fff;margin-bottom:6px}.rfb-condition:last-child{margin-bottom:0}.rfb-cond-num{font-size:11px;font-weight:700;color:#98a2b3;min-width:18px;text-align:center}.rfb-cond-select,.rfb-cond-input{min-height:30px;padding:0 8px;border:1px solid #e4e7ec;border-radius:7px;font-size:11px;color:#1f2937;background:#fff;outline:none}.rfb-cond-select:focus,.rfb-cond-input:focus{border-color:rgba(37,99,235,.55);box-shadow:0 0 0 3px rgba(37,99,235,.1)}.rfb-cond-remove{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border:none;border-radius:6px;background:rgba(220,38,38,.08);color:#dc2626;font-size:14px;cursor:pointer;transition:background .15s}.rfb-cond-remove:hover{background:rgba(220,38,38,.18)}.rfb-logic-row{display:flex;align-items:center;gap:10px;padding:10px 0 4px;font-size:12px;color:#667085}.rfb-logic-row label{display:inline-flex;align-items:center;gap:4px;cursor:pointer;padding:4px 10px;border-radius:6px;border:1px solid #e4e7ec;background:#fff;font-size:11px;font-weight:600;transition:all .15s}.rfb-logic-row label:has(input:checked){border-color:#2563eb;background:rgba(37,99,235,.08);color:#2563eb}.rfb-logic-row input[type=radio]{display:none}.rfb-foot{display:flex;align-items:center;justify-content:space-between;padding:12px 0 0;border-top:1px solid #e4e7ec;margin-top:10px}.rfb-match-info{font-size:11px;color:#667085}.rfb-match-info strong{color:#1f2937}.rfb-sidebar-card{padding:14px;margin:12px 0;border:1px solid #e4e7ec;border-radius:8px;background:#f8fafc}.rfb-sidebar-kicker{font-size:10px;font-weight:800;color:#98a2b3;letter-spacing:.1em;text-transform:uppercase;margin-bottom:8px}.rfb-sidebar-stat{font-size:12px;color:#667085;margin-bottom:4px}.rfb-sidebar-stat strong{color:#1f2937}.rfb-sidebar-rule{font-size:10px;color:#98a2b3;margin-bottom:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\";\ndocument.head.appendChild(_rfbStyle);\n\nregisterTool({\n  id: \"row-filter-builder\",\n  name: \"Row Filter Builder\",\n  icon: \"🔍\",\n  description: \"Build complex multi-condition filters to show or hide rows based on any combination of rules.\",\n\n  activate: function() {\n    var self = this;\n    this._createButton();\n    this._createPanel();\n    this._createSidebar();\n    this._renderConditions();\n    this._updateSidebar();\n  },\n\n  deactivate: function() {\n    this._removeButton();\n    this._removePanel();\n    this._removeSidebar();\n  },\n\n  _createButton: function() {\n    var self = this;\n    var slot = document.getElementById(\"toolButtonsSlot\");\n    this._btn = document.createElement(\"button\");\n    this._btn.className = \"button button-quiet button-small\";\n    this._btn.textContent = \"🔍 Filter\";\n    this._btn.addEventListener(\"click\", function() { self._applyFilter(); });\n    slot.appendChild(this._btn);\n  },\n\n  _removeButton: function() {\n    if (this._btn) { this._btn.remove(); this._btn = null; }\n  },\n\n  _createPanel: function() {\n    var self = this;\n    var slot = document.getElementById(\"toolPanelsSlot\");\n    this._panel = document.createElement(\"div\");\n    this._panel.className = \"rfb-panel\";\n    this._panel.innerHTML = '<div class=\"rfb-head\">'\n      + '<div><div style=\"font-size:10px;font-weight:800;color:#98a2b3;letter-spacing:.14em;text-transform:uppercase\">Row Filter</div>'\n      + '<h3 style=\"margin:4px 0 0;font-size:16px\">Filter Conditions</h3>'\n      + '<p style=\"margin:3px 0 0;font-size:12px;color:#667085\">Add rules to show only matching rows. Unmatched rows are hidden.</p></div>'\n      + '<div class=\"rfb-head-actions\">'\n      + '<button class=\"button button-primary button-small\" id=\"rfb-add\">Add Rule</button>'\n      + '<button class=\"button button-ghost button-small\" id=\"rfb-apply\">Apply</button>'\n      + '<button class=\"button button-danger button-small\" id=\"rfb-clear\">Clear All</button>'\n      + '</div></div>'\n      + '<div class=\"rfb-body\">'\n      + '<div class=\"rfb-logic-row\"><span>Match</span>'\n      + '<label><input type=\"radio\" name=\"rfb-logic\" value=\"and\" checked> All (AND)</label>'\n      + '<label><input type=\"radio\" name=\"rfb-logic\" value=\"or\"> Any (OR)</label>'\n      + '</div>'\n      + '<div id=\"rfb-conditions\"><div class=\"rfb-empty\">No rules yet. Click \"Add Rule\" to start filtering.</div></div>'\n      + '<div class=\"rfb-foot\"><div class=\"rfb-match-info\" id=\"rfb-match-info\"></div>'\n      + '<div style=\"display:flex;gap:6px\"><button class=\"button button-ghost button-small\" id=\"rfb-show-all\">Show All Rows</button></div></div>'\n      + '</div>';\n    slot.appendChild(this._panel);\n\n    this._panel.querySelector(\"#rfb-add\").addEventListener(\"click\", function() { self._addCondition(); });\n    this._panel.querySelector(\"#rfb-apply\").addEventListener(\"click\", function() { self._applyFilter(); });\n    this._panel.querySelector(\"#rfb-clear\").addEventListener(\"click\", function() { self._clearAll(); });\n    this._panel.querySelector(\"#rfb-show-all\").addEventListener(\"click\", function() { self._showAll(); });\n\n    var radios = this._panel.querySelectorAll(\"input[name='rfb-logic']\");\n    radios.forEach(function(radio) {\n      radio.addEventListener(\"change\", function() {\n        _rfb.logicMode = this.value;\n      });\n    });\n  },\n\n  _removePanel: function() {\n    if (this._panel) { this._panel.remove(); this._panel = null; }\n  },\n\n  _createSidebar: function() {\n    var slot = document.getElementById(\"toolSidebarSlot\");\n    this._sidebar = document.createElement(\"div\");\n    this._sidebar.className = \"rfb-sidebar-card\";\n    this._sidebar.innerHTML = '<div class=\"rfb-sidebar-kicker\">Filter Builder</div>'\n      + '<div id=\"rfb-sidebar-content\"><div class=\"rfb-sidebar-stat\">No active filters</div></div>';\n    slot.appendChild(this._sidebar);\n  },\n\n  _removeSidebar: function() {\n    if (this._sidebar) { this._sidebar.remove(); this._sidebar = null; }\n  },\n\n  _addCondition: function() {\n    _rfb.conditions.push({ column: 0, operator: \"contains\", value: \"\" });\n    this._renderConditions();\n  },\n\n  _removeCondition: function(index) {\n    _rfb.conditions.splice(index, 1);\n    this._renderConditions();\n  },\n\n  _getColumnOptions: function() {\n    var sheet = currentSheet();\n    if (!sheet) return '<option>No sheet loaded</option>';\n    return sheet.headers.map(function(h, i) {\n      return '<option value=\"' + i + '\">' + escapeHTML(valueToString(h).trim() || \"Column \" + (i + 1)) + '</option>';\n    }).join(\"\");\n  },\n\n  _renderConditions: function() {\n    if (!this._panel) return;\n    var self = this;\n    var container = this._panel.querySelector(\"#rfb-conditions\");\n    if (!_rfb.conditions.length) {\n      container.innerHTML = '<div class=\"rfb-empty\">No rules yet. Click \"Add Rule\" to start filtering.</div>';\n      this._updateMatchInfo();\n      return;\n    }\n    var colOpts = this._getColumnOptions();\n    var ops = [\n      { v: \"contains\", t: \"Contains\" },\n      { v: \"equals\", t: \"Equals\" },\n      { v: \"starts\", t: \"Starts with\" },\n      { v: \"ends\", t: \"Ends with\" },\n      { v: \"gt\", t: \">\" },\n      { v: \"gte\", t: \">=\" },\n      { v: \"lt\", t: \"<\" },\n      { v: \"lte\", t: \"<=\" },\n      { v: \"empty\", t: \"Is empty\" },\n      { v: \"not-empty\", t: \"Is not empty\" },\n      { v: \"regex\", t: \"Matches regex\" }\n    ];\n    var opOpts = ops.map(function(o) {\n      return '<option value=\"' + o.v + '\">' + o.t + '</option>';\n    }).join(\"\");\n\n    container.innerHTML = _rfb.conditions.map(function(cond, i) {\n      var valDisabled = (cond.operator === \"empty\" || cond.operator === \"not-empty\") ? ' style=\"opacity:.4;pointer-events:none\"' : '';\n      var opOptsHtml = ops.map(function(o) {\n        return '<option value=\"' + o.v + '\"' + (cond.operator === o.v ? ' selected' : '') + '>' + o.t + '</option>';\n      }).join(\"\");\n      return '<div class=\"rfb-condition\">'\n        + '<span class=\"rfb-cond-num\">' + (i + 1) + '</span>'\n        + '<select class=\"rfb-cond-select\" data-rfb-idx=\"' + i + '\" data-rfb-field=\"column\">' + colOpts.replace('value=\"' + cond.column + '\"', 'value=\"' + cond.column + '\" selected') + '</select>'\n        + '<select class=\"rfb-cond-select\" data-rfb-idx=\"' + i + '\" data-rfb-field=\"operator\">' + opOptsHtml + '</select>'\n        + '<input class=\"rfb-cond-input\" type=\"text\" data-rfb-idx=\"' + i + '\" data-rfb-field=\"value\" placeholder=\"Value...\" value=\"' + escapeHTML(cond.value) + '\"' + valDisabled + '>'\n        + '<button class=\"rfb-cond-remove\" data-rfb-remove=\"' + i + '\" title=\"Remove rule\">&times;</button>'\n        + '</div>';\n    }).join(\"\");\n\n    container.querySelectorAll(\"[data-rfb-field]\").forEach(function(el) {\n      el.addEventListener(\"change\", function() {\n        var idx = parseInt(this.getAttribute(\"data-rfb-idx\"));\n        var field = this.getAttribute(\"data-rfb-field\");\n        _rfb.conditions[idx][field] = field === \"column\" ? parseInt(this.value) : this.value;\n        if (field === \"operator\") self._renderConditions();\n      });\n      el.addEventListener(\"input\", function() {\n        var idx = parseInt(this.getAttribute(\"data-rfb-idx\"));\n        var field = this.getAttribute(\"data-rfb-field\");\n        if (field === \"value\") _rfb.conditions[idx].value = this.value;\n      });\n    });\n\n    container.querySelectorAll(\"[data-rfb-remove]\").forEach(function(el) {\n      el.addEventListener(\"click\", function() {\n        var idx = parseInt(this.getAttribute(\"data-rfb-remove\"));\n        self._removeCondition(idx);\n      });\n    });\n\n    this._updateMatchInfo();\n  },\n\n  _matchCondition: function(row, sheet, cond) {\n    var cellVal = row.values[cond.column];\n    var text = normalizeText(cellVal);\n    var rawText = valueToString(cellVal);\n    var numVal = parseNumber(cellVal);\n    var filterNum = parseNumber(cond.value);\n    var filterText = normalizeText(cond.value);\n\n    switch (cond.operator) {\n      case \"contains\": return text.indexOf(filterText) !== -1;\n      case \"equals\": return text === filterText;\n      case \"starts\": return text.indexOf(filterText) === 0;\n      case \"ends\": return text.indexOf(filterText) === text.length - filterText.length;\n      case \"gt\": return numVal !== null && filterNum !== null && numVal > filterNum;\n      case \"gte\": return numVal !== null && filterNum !== null && numVal >= filterNum;\n      case \"lt\": return numVal !== null && filterNum !== null && numVal < filterNum;\n      case \"lte\": return numVal !== null && filterNum !== null && numVal <= filterNum;\n      case \"empty\": return !rawText.trim();\n      case \"not-empty\": return !!rawText.trim();\n      case \"regex\":\n        try { return new RegExp(cond.value, \"i\").test(rawText); }\n        catch (e) { return false; }\n      default: return true;\n    }\n  },\n\n  _applyFilter: function() {\n    var sheet = currentSheet();\n    if (!sheet) { showToast(\"No sheet loaded.\", \"error\"); return; }\n    if (!_rfb.conditions.length) { showToast(\"Add at least one filter rule.\", \"error\"); return; }\n    var self = this;\n    var matchCount = 0;\n    var hideCount = 0;\n    sheet.rows.forEach(function(row) {\n      var results = _rfb.conditions.map(function(cond) {\n        return self._matchCondition(row, sheet, cond);\n      });\n      var matched = _rfb.logicMode === \"and\"\n        ? results.every(function(r) { return r; })\n        : results.some(function(r) { return r; });\n      row.hidden = !matched;\n      if (matched) matchCount++; else hideCount++;\n    });\n    refresh();\n    this._updateMatchInfo();\n    this._updateSidebar();\n    showToast(\"Filter applied: \" + formatNumber(matchCount) + \" rows shown, \" + formatNumber(hideCount) + \" hidden.\", \"success\");\n  },\n\n  _showAll: function() {\n    var sheet = currentSheet();\n    if (!sheet) return;\n    sheet.rows.forEach(function(row) { row.hidden = false; });\n    refresh();\n    this._updateMatchInfo();\n    this._updateSidebar();\n    showToast(\"All rows shown.\", \"success\");\n  },\n\n  _clearAll: function() {\n    _rfb.conditions = [];\n    _rfb.logicMode = \"and\";\n    var radios = this._panel.querySelectorAll(\"input[name='rfb-logic']\");\n    radios.forEach(function(r) { r.checked = r.value === \"and\"; });\n    this._showAll();\n    this._renderConditions();\n    showToast(\"All filter rules cleared.\", \"success\");\n  },\n\n  _updateMatchInfo: function() {\n    if (!this._panel) return;\n    var info = this._panel.querySelector(\"#rfb-match-info\");\n    var sheet = currentSheet();\n    if (!sheet || !_rfb.conditions.length) {\n      info.innerHTML = \"\";\n      return;\n    }\n    var visible = sheet.rows.filter(function(r) { return !r.hidden; }).length;\n    info.innerHTML = '<strong>' + formatNumber(visible) + '</strong> of ' + formatNumber(sheet.rows.length) + ' rows visible (' + _rfb.conditions.length + ' rule' + (_rfb.conditions.length === 1 ? '' : 's') + ', ' + _rfb.logicMode.toUpperCase() + ')';\n  },\n\n  _updateSidebar: function() {\n    if (!this._sidebar) return;\n    var content = this._sidebar.querySelector(\"#rfb-sidebar-content\");\n    var sheet = currentSheet();\n    if (!sheet || !_rfb.conditions.length) {\n      content.innerHTML = '<div class=\"rfb-sidebar-stat\">No active filters</div>';\n      return;\n    }\n    var visible = sheet.rows.filter(function(r) { return !r.hidden; }).length;\n    var total = sheet.rows.length;\n    var rules = _rfb.conditions.map(function(c) {\n      var colName = valueToString(sheet.headers[c.column]).trim() || \"Col \" + (c.column + 1);\n      return '<div class=\"rfb-sidebar-rule\">' + escapeHTML(colName) + ' ' + c.operator + (c.value ? ' \"' + escapeHTML(c.value) + '\"' : '') + '</div>';\n    }).join(\"\");\n    content.innerHTML = '<div class=\"rfb-sidebar-stat\"><strong>' + formatNumber(visible) + '</strong> / ' + formatNumber(total) + ' rows visible</div>'\n      + '<div class=\"rfb-sidebar-stat\">Logic: ' + _rfb.logicMode.toUpperCase() + '</div>'\n      + rules;\n  }\n});"
  }
}