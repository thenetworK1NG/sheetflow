{
  "format": "sheetflow-tool",
  "version": 1,
  "tool": {
    "id": "hide-restore",
    "name": "Hide & Restore",
    "icon": "⊘",
    "description": "Hide individual rows, restore hidden rows, hide zero-value rows, or restore all.",
    "author": "Sheetflow",
    "version": "1.0.0",
    "code": "(function() {\n  var _hr = { refs: {}, state: {}, _hook: null, _boundClick: null, _boundChange: null };\n  _hr.state = { selectedIds: new Set() };\n  function injectUI() {\n    var slot = document.getElementById(\"toolPanelsSlot\");\n    if (!slot) return;\n    var div = document.createElement(\"div\");\n    div.id = \"_hr_panel\";\n    div.style.cssText = \"margin-bottom:16px;padding:14px 18px;border:1px solid var(--line);border-radius:10px;background:var(--panel);\";\n    div.innerHTML = '<div style=\"display:flex;align-items:center;gap:8px;flex-wrap:wrap;\">'\n      + '<button id=\"_hr_hideSelected\" type=\"button\" class=\"button button-small button-ghost\" disabled>Hide selected</button>'\n      + '<button id=\"_hr_restoreSelected\" type=\"button\" class=\"button button-small button-ghost\" disabled>Restore selected</button>'\n      + '<button id=\"_hr_hideZero\" type=\"button\" class=\"button button-small button-ghost\" disabled>Hide zero values</button>'\n      + '<button id=\"_hr_restoreAll\" type=\"button\" class=\"button button-small button-ghost\" disabled>Restore all</button>'\n      + '<button id=\"_hr_clearSel\" type=\"button\" class=\"button button-small button-ghost\">Clear selection</button>'\n      + '<span id=\"_hr_selCount\" style=\"font-size:11px;font-weight:700;color:#2563eb;\"></span>'\n      + '</div>';\n    slot.appendChild(div);\n    _hr.refs.hideSelected = document.getElementById(\"_hr_hideSelected\");\n    _hr.refs.restoreSelected = document.getElementById(\"_hr_restoreSelected\");\n    _hr.refs.hideZero = document.getElementById(\"_hr_hideZero\");\n    _hr.refs.restoreAll = document.getElementById(\"_hr_restoreAll\");\n    _hr.refs.clearSel = document.getElementById(\"_hr_clearSel\");\n    _hr.refs.selCount = document.getElementById(\"_hr_selCount\");\n  }\n  function onTableClick(event) {\n    var action = event.target.closest(\"[data-action]\");\n    if (!action) return;\n    if (action.dataset.action === \"toggle-row\") toggleRow(action.dataset.rowId);\n  }\n  function onTableChange(event) {\n    var input = event.target;\n    if (!(input instanceof HTMLInputElement)) return;\n    if (input.matches(\"[data-row-select]\")) {\n      if (input.checked) _hr.state.selectedIds.add(input.dataset.rowSelect);\n      else _hr.state.selectedIds.delete(input.dataset.rowSelect);\n      refresh();\n    }\n    if (input.matches(\"[data-all-select]\")) {\n      var sheet = currentSheet();\n      if (!sheet) return;\n      sheet.rows.forEach(function(row) { input.checked ? _hr.state.selectedIds.add(row.id) : _hr.state.selectedIds.delete(row.id); });\n      refresh();\n    }\n  }\n  function captureVis() {\n    var snap = new Map();\n    state.sheetStates.forEach(function(sheet, name) { snap.set(name, sheet.rows.map(function(r) { return Boolean(r.hidden); })); });\n    return snap;\n  }\n  function commitHist(label, before) {\n    var after = captureVis();\n    state.history = state.history.slice(0, state.historyIndex + 1);\n    state.history.push({ label: label, before: before, after: after });\n    if (state.history.length > 50) state.history.shift();\n    state.historyIndex = state.history.length - 1;\n  }\n  function toggleRow(id) {\n    var sheet = currentSheet();\n    if (!sheet) return;\n    var row = sheet.rows.find(function(r) { return r.id === id; });\n    if (!row) return;\n    var before = captureVis();\n    row.hidden = !row.hidden;\n    _hr.state.selectedIds.delete(id);\n    commitHist(row.hidden ? \"Hide row\" : \"Restore row\", before);\n    refresh();\n  }\n  function hideSelected() {\n    var sheet = currentSheet();\n    if (!sheet || !_hr.state.selectedIds.size) return;\n    var before = captureVis();\n    var count = 0;\n    sheet.rows.forEach(function(row) { if (_hr.state.selectedIds.has(row.id)) { row.hidden = true; count++; } });\n    _hr.state.selectedIds.clear();\n    commitHist(\"Hide selected rows\", before);\n    refresh();\n    showToast(count + \" row\" + (count === 1 ? \"\" : \"s\") + \" hidden.\");\n  }\n  function restoreSelected() {\n    var sheet = currentSheet();\n    if (!sheet || !_hr.state.selectedIds.size) return;\n    var before = captureVis();\n    var count = 0;\n    sheet.rows.forEach(function(row) { if (_hr.state.selectedIds.has(row.id)) { row.hidden = false; count++; } });\n    _hr.state.selectedIds.clear();\n    commitHist(\"Restore selected rows\", before);\n    refresh();\n    showToast(count + \" row\" + (count === 1 ? \"\" : \"s\") + \" restored.\", \"success\");\n  }\n  function hideZero() {\n    var sheet = currentSheet();\n    if (!sheet || sheet.quantityColumn === null) return;\n    var before = captureVis();\n    var count = 0;\n    sheet.rows.forEach(function(row) { if (!row.hidden && parseNumber(row.values[sheet.quantityColumn]) === 0) { row.hidden = true; count++; } });\n    commitHist(\"Hide zero-value rows\", before);\n    refresh();\n    showToast(count ? count + \" zero-value row\" + (count === 1 ? \"\" : \"s\") + \" hidden.\" : \"No visible zero-value rows found.\");\n  }\n  function restoreAllFn() {\n    var sheet = currentSheet();\n    if (!sheet) return;\n    var before = captureVis();\n    var count = sheet.rows.filter(function(r) { return r.hidden; }).length;\n    sheet.rows.forEach(function(r) { r.hidden = false; });\n    _hr.state.selectedIds.clear();\n    commitHist(\"Restore all rows\", before);\n    refresh();\n    showToast(count ? count + \" row\" + (count === 1 ? \"\" : \"s\") + \" restored.\" : \"Everything is already visible.\", \"success\");\n  }\n  function updateBtns() {\n    var sheet = currentSheet();\n    var sel = _hr.state.selectedIds.size > 0;\n    var hasHidden = sheet && sheet.rows.some(function(r) { return r.hidden; });\n    _hr.refs.hideSelected.disabled = !sel;\n    _hr.refs.restoreSelected.disabled = !sel;\n    _hr.refs.hideZero.disabled = !sheet || sheet.quantityColumn === null;\n    _hr.refs.restoreAll.disabled = !hasHidden;\n    _hr.refs.selCount.textContent = sel ? _hr.state.selectedIds.size + \" selected\" : \"\";\n  }\n  _hr._hook = function() {\n    var sheet = currentSheet();\n    if (!sheet || !_hr.refs.hideSelected) return;\n    var groups = buildGroups(sheet);\n    var visible = sheet.rows;\n    var visibleItems = pageItems(visible);\n    var selectAll = _hr.state.selectedIds.size === visible.length && visible.length > 0;\n    refs.tableHead.innerHTML = \"<tr><th class='row-number'>#</th><th style='width:42px;padding-right:3px;padding-left:13px;'><input type='checkbox' id='_hr_allSelect' aria-label='Select all' \" + (selectAll ? \"checked\" : \"\") + \" style='width:15px;height:15px;'></th>\"\n      + sheet.headers.map(function(h) { return \"<th>\" + escapeHTML(h) + \"</th>\"; }).join(\"\") + \"<th>Actions</th></tr>\";\n    refs.tableBody.innerHTML = visibleItems.map(function(row) {\n      return '<tr class=\"' + (row.hidden ? 'is-hidden' : '') + '\"><td class=\"row-number-cell\">' + row.sourceRowNumber + '</td>' + '<td style=\"width:42px;padding-right:3px;padding-left:13px;\"><input type=\"checkbox\" aria-label=\"Select row ' + row.sourceRowNumber + '\" data-row-select=\"' + escapeHTML(row.id) + '\" ' + (_hr.state.selectedIds.has(row.id) ? \"checked\" : \"\") + ' style=\"width:15px;height:15px;\"></td>' + row.values.map(function(v, i) { return '<td data-cell-row=\"' + escapeHTML(row.id) + '\" data-cell-column=\"' + i + '\">' + formatCell(v) + '</td>'; }).join(\"\") + '<td style=\"width:100px;text-align:right;white-space:nowrap;\"><button class=\"row-action ' + (row.hidden ? \"restore\" : \"\") + '\" type=\"button\" data-action=\"toggle-row\" data-row-id=\"' + escapeHTML(row.id) + '\" style=\"min-height:29px;padding:0 9px;border:1px solid var(--line);border-radius:7px;color:var(--muted);background:transparent;font-size:10px;font-weight:750;cursor:pointer;\">' + (row.hidden ? \"Restore\" : \"Hide\") + '</button></td></tr>';\n    }).join(\"\");\n    var allSel = document.getElementById(\"_hr_allSelect\");\n    if (allSel) {\n      allSel.addEventListener(\"change\", function() {\n        sheet.rows.forEach(function(r) { allSel.checked ? _hr.state.selectedIds.add(r.id) : _hr.state.selectedIds.delete(r.id); });\n        refresh();\n      });\n    }\n    updateBtns();\n    refs.resultCount.textContent = visible.length + \" row\" + (visible.length === 1 ? \"\" : \"s\");\n  };\n  function bindEvents() {\n    _hr.refs.hideSelected.addEventListener(\"click\", hideSelected);\n    _hr.refs.restoreSelected.addEventListener(\"click\", restoreSelected);\n    _hr.refs.hideZero.addEventListener(\"click\", hideZero);\n    _hr.refs.restoreAll.addEventListener(\"click\", restoreAllFn);\n    _hr.refs.clearSel.addEventListener(\"click\", function() { _hr.state.selectedIds.clear(); refresh(); });\n    _hr._boundClick = onTableClick;\n    _hr._boundChange = onTableChange;\n    refs.tableBody.addEventListener(\"click\", _hr._boundClick);\n    refs.tableBody.addEventListener(\"change\", _hr._boundChange);\n  }\n  function removeUI() {\n    var panel = document.getElementById(\"_hr_panel\");\n    if (panel) panel.remove();\n    _hr.refs = {};\n    if (_hr._boundClick) refs.tableBody.removeEventListener(\"click\", _hr._boundClick);\n    if (_hr._boundChange) refs.tableBody.removeEventListener(\"change\", _hr._boundChange);\n  }\n    registerTool({ id: \"hide-restore\", name: \"Hide & Restore\", icon: \"\\u2298\", description: \"Hide individual rows, restore hidden rows, hide zero-value rows.\",\n    activate() { injectUI(); bindEvents(); chainRefresh(_hr._hook); refresh(); },\n    deactivate() { removeUI(); unchainRefresh(_hr._hook); refresh(); }\n  });\n})();"
  }
}