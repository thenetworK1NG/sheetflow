TML = '<section class=\"automation-panel\" id=\"aaAutomationPanel\" hidden><div class=\"automation-head\"><div><div class=\"section-kicker\">Repeatable cleanup</div><h2>Automation rules</h2><p class=\"section-copy\" id=\"aaAutomationSummary\">Create rules for the rows you remove every day.</p></div><div class=\"automation-actions\"><button class=\"button button-quiet button-small\" id=\"aaRunAutomationButton\" type=\"button\" disabled>Run rules</button><button class=\"button button-primary button-small\" id=\"aaAddRuleButton\" type=\"button\">New rule</button><button class=\"button button-ghost button-small\" id=\"aaExportRulesButton\" type=\"button\">Export</button><button class=\"button button-ghost button-small\" id=\"aaImportRulesButton\" type=\"button\">Import</button><button class=\"button button-ghost button-small\" id=\"aaCloseAutomationButton\" type=\"button\">Close</button></div></div><div class=\"automation-list\" id=\"aaAutomationList\"></div><div class=\"rule-select-bar\" id=\"aaRuleSelectBar\" hidden><span class=\"rule-select-count\" id=\"aaRuleSelectCount\">0 selected</span><div class=\"rule-select-actions\"><button class=\"button button-primary button-small\" id=\"aaConvertSelectedButton\" type=\"button\">Convert selected to addon</button><button class=\"button button-ghost button-small\" id=\"aaClearRuleSelectionButton\" type=\"button\">Clear selection</button></div></div><form class=\"automation-form\" id=\"aaAutomationForm\" hidden><div class=\"automation-form-head\"><strong id=\"aaRuleFormTitle\">New automation rule</strong><span>Rules hide matching rows; they never delete data.</span></div><div class=\"automation-form-grid\"><label class=\"form-field\"><span>Rule name</span><input id=\"aaRuleNameInput\" type=\"text\" maxlength=\"80\" placeholder=\"Hide unwanted records\"></label><label class=\"form-field\"><span>Column</span><select id=\"aaRuleColumnSelect\"></select></label><label class=\"form-field\"><span>Condition</span><select id=\"aaRuleOperatorSelect\"><option value=\"contains\">Contains</option><option value=\"equals\">Equals</option></select></label><label class=\"form-field\"><span>Value</span><input id=\"aaRuleValueInput\" type=\"text\" maxlength=\"120\" placeholder=\"TEST or <empty>\"><small class=\"form-hint\">Use &lt;empty&gt; to match blank cells.</small></label></div><div class=\"automation-form-actions\"><button class=\"button button-ghost button-small\" id=\"aaCancelRuleButton\" type=\"button\">Cancel</button><button class=\"button button-primary button-small\" id=\"aaSaveRuleButton\" type=\"submit\">Save rule</button></div></form></section><section class=\"addon-panel\" id=\"aaAddonPanel\" hidden><div class=\"addon-head\"><div><div class=\"section-kicker\">Custom code</div><h2>Addons</h2><p class=\"section-copy\" id=\"aaAddonSummary\">Write custom JavaScript to process your spreadsheet data.</p></div><div class=\"addon-actions\"><button class=\"button button-quiet button-small\" id=\"aaRunAllAddonsButton\" type=\"button\" disabled>Run all</button><button class=\"button button-primary button-small\" id=\"aaAddAddonButton\" type=\"button\">New addon</button><button class=\"button button-ghost button-small\" id=\"aaExportAddonsButton\" type=\"button\">Export</button><button class=\"button button-ghost button-small\" id=\"aaImportAddonsButton\" type=\"button\">Import</button><button class=\"button button-ghost button-small\" id=\"aaAddonInstructionsButton\" type=\"button\">Instructions</button><button class=\"button button-ghost button-small\" id=\"aaCloseAddonButton\" type=\"button\">Close</button></div></div><div class=\"addon-list\" id=\"aaAddonList\"></div><form class=\"addon-form\" id=\"aaAddonForm\" hidden><div class=\"addon-form-head\"><strong id=\"aaAddonFormTitle\">New addon</strong><span>Addons run custom code on your spreadsheet data.</span></div><div class=\"addon-form-grid\"><label class=\"form-field\"><span>Addon name</span><input id=\"aaAddonNameInput\" type=\"text\" maxlength=\"80\" placeholder=\"My custom addon\"></label><label class=\"form-field\"><span>Description</span><input id=\"aaAddonDescInput\" type=\"text\" maxlength=\"200\" placeholder=\"What this addon does\"></label><label class=\"addon-form-check\"><input id=\"aaAddonAutoRun\" type=\"checkbox\"><span>Auto-run on file import</span></label><label class=\"addon-form-check\"><input id=\"aaAddonPasswordToggle\" type=\"checkbox\"><span>Password protect this addon</span></label><div class=\"addon-password-wrap\" id=\"aaAddonPasswordWrap\" hidden><label class=\"form-field\"><span>Password</span><input id=\"aaAddonPasswordInput\" type=\"password\" maxlength=\"120\" placeholder=\"Enter a password to lock this addon\"></label></div><div class=\"form-field addon-code-field\"><span>Code</span><textarea class=\"addon-code-editor\" id=\"aaAddonCodeInput\" rows=\"12\" placeholder=\"// Your JavaScript code here...\\n// Use the api object to interact with the spreadsheet.\\n// See the Instructions page for the full API reference.\"></textarea></div></div><div class=\"addon-form-actions\"><button class=\"button button-ghost button-small\" id=\"aaCancelAddonButton\" type=\"button\">Cancel</button><button class=\"button button-primary button-small\" id=\"aaSaveAddonButton\" type=\"submit\">Save addon</button></div></form></section>';\n  var _workspace = _main.querySelector(\".workspace\");\n  if (_workspace) _main.insertBefore(_panels, _workspace);\n}\n\nvar _modalDiv = document.createElement(\"div\");\n_modalDiv.innerHTML = '<div class=\"aa-modal-overlay\" id=\"aaPasswordModal\"><div class=\"aa-modal\"><h3 id=\"aaPasswordModalTitle\">Addon is password-protected</h3><p id=\"aaPasswordModalDesc\">This addon requires a password to import and use.</p><input type=\"password\" id=\"aaPasswordModalInput\" placeholder=\"Enter addon password\" autocomplete=\"off\"><div class=\"aa-modal-error\" id=\"aaPasswordModalError\"></div><div class=\"aa-modal-actions\"><button class=\"button button-ghost button-small\" id=\"aaPasswordModalCancel\" type=\"button\">Cancel</button><button class=\"button button-primary button-small\" id=\"aaPasswordModalConfirm\" type=\"button\">Unlock</button></div></div></div>';\ndocument.body.appendChild(_modalDiv);\n\nfunction _el(id) { return document.getElementById(id); }\n\n_r.automationButton = _el(\"aaAutomationButton\");\n_r.addonButton = _el(\"aaAddonButton\");\n_r.automationRuleCount = _el(\"aaAutomationRuleCount\");\n_r.addonCount = _el(\"aaAddonCount\");\n_r.automationPanel = _el(\"aaAutomationPanel\");\n_r.automationSummary = _el(\"aaAutomationSummary\");\n_r.automationList = _el(\"aaAutomationList\");\n_r.runAutomationButton = _el(\"aaRunAutomationButton\");\n_r.addRuleButton = _el(\"aaAddRuleButton\");\n_r.closeAutomationButton = _el(\"aaCloseAutomationButton\");\n_r.automationForm = _el(\"aaAutomationForm\");\n_r.ruleFormTitle = _el(\"aaRuleFormTitle\");\n_r.ruleNameInput = _el(\"aaRuleNameInput\");\n_r.ruleColumnSelect = _el(\"aaRuleColumnSelect\");\n_r.ruleOperatorSelect = _el(\"aaRuleOperatorSelect\");\n_r.ruleValueInput = _el(\"aaRuleValueInput\");\n_r.cancelRuleButton = _el(\"aaCancelRuleButton\");\n_r.saveRuleButton = _el(\"aaSaveRuleButton\");\n_r.exportRulesButton = _el(\"aaExportRulesButton\");\n_r.importRulesButton = _el(\"aaImportRulesButton\");\n_r.importRulesInput = _el(\"aaImportRulesInput\");\n_r.ruleSelectBar = _el(\"aaRuleSelectBar\");\n_r.ruleSelectCount = _el(\"aaRuleSelectCount\");\n_r.convertSelectedButton = _el(\"aaConvertSelectedButton\");\n_r.clearRuleSelectionButton = _el(\"aaClearRuleSelectionButton\");\n_r.addonPanel = _el(\"aaAddonPanel\");\n_r.addonSummary = _el(\"aaAddonSummary\");\n_r.addonList = _el(\"aaAddonList\");\n_r.runAllAddonsButton = _el(\"aaRunAllAddonsButton\");\n_r.addAddonButton = _el(\"aaAddAddonButton\");\n_r.addonInstructionsButton = _el(\"aaAddonInstructionsButton\");\n_r.closeAddonButton = _el(\"aaCloseAddonButton\");\n_r.addonForm = _el(\"aaAddonForm\");\n_r.addonFormTitle = _