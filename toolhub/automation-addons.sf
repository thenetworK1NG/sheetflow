py strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}.addon-card-copy p{margin:3px 0 0;overflow:hidden;color:#667085;font-size:11px;text-overflow:ellipsis;white-space:nowrap}.addon-card-meta{display:block;margin-top:3px;color:#98a2b3;font-size:10px}.addon-card-actions{display:flex;align-items:center;gap:5px}.addon-card-actions .button{min-height:28px;padding:0 8px;font-size:10px}.addon-tag{display:inline-flex;align-items:center;min-height:18px;padding:0 6px;border-radius:5px;color:#2563eb;background:rgba(37,99,235,.09);font-size:9px;font-weight:750;margin-left:6px}.addon-form{margin:0 21px 18px;padding:15px;border:1px solid rgba(37,99,235,.2);border-radius:10px;background:rgba(37,99,235,.09)}.addon-form-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:12px}.addon-form-head strong{font-size:12px}.addon-form-head span{color:#667085;font-size:10px}.addon-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.addon-code-field{grid-column:1/-1}.addon-code-editor{width:100%;min-height:220px;max-height:50vh;padding:12px;border:1px solid #e4e7ec;border-radius:7px;outline:none;color:#1f2937;background:#fff;font-family:'Cascadia Code','Fira Code',Consolas,monospace;font-size:12px;line-height:1.55;resize:vertical;tab-size:2;white-space:pre;overflow:auto}.addon-code-editor:focus{border-color:rgba(37,99,235,.55);box-shadow:0 0 0 3px rgba(37,99,235,.1)}.addon-form-check{display:inline-flex;align-items:center;gap:7px;color:#667085;font-size:11px;cursor:pointer}.addon-form-check input{width:15px;height:15px;margin:0;accent-color:#2563eb;cursor:pointer}.addon-form-actions{display:flex;justify-content:flex-end;gap:7px;margin-top:12px}.convert-rule-tag{display:inline-flex;align-items:center;min-height:20px;padding:0 6px;border-radius:5px;color:#2563eb;background:rgba(37,99,235,.09);font-size:9px;font-weight:750;cursor:pointer;border:0;transition:background .14s}.convert-rule-tag:hover{background:rgba(37,99,235,.16)}.addon-encrypted-badge{display:inline-flex;align-items:center;gap:4px;min-height:20px;padding:0 7px;border-radius:5px;color:#b45309;background:rgba(180,83,9,.08);font-size:9px;font-weight:750}.rule-select{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;background:rgba(37,99,235,.09)}.rule-select input{width:15px;height:15px;margin:0;accent-color:#2563eb;cursor:pointer}.rule-select-bar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 21px;border-bottom:1px solid #e4e7ec;background:rgba(37,99,235,.09)}.rule-select-count{color:#2563eb;font-size:11px;font-weight:750}.rule-select-actions{display:flex;align-items:center;gap:6px}.addon-password-wrap{display:grid;gap:5px;margin-top:4px}.addon-password-wrap input{min-height:37px;width:100%;padding:0 10px;border:1px solid #e4e7ec;border-radius:7px;outline:none;color:#1f2937;background:#fff;font-size:12px}.addon-password-wrap input:focus{border-color:rgba(37,99,235,.55);box-shadow:0 0 0 3px rgba(37,99,235,.1)}.aa-modal-overlay{position:fixed;inset:0;z-index:50;display:grid;place-items:center;background:rgba(16,24,40,.45);backdrop-filter:blur(3px);opacity:0;pointer-events:none;transition:opacity .18s}.aa-modal-overlay.is-open{opacity:1;pointer-events:auto}.aa-modal{width:min(420px,calc(100vw - 32px));padding:24px;border:1px solid #cfd5dd;border-radius:14px;background:#fff;box-shadow:0 20px 50px rgba(16,24,40,.2)}.aa-modal h3{margin:0 0 6px;font-size:16px;font-weight:720}.aa-modal p{margin:0 0 16px;color:#667085;font-size:12px;line-height:1.6}.aa-modal input[type=password]{width:100%;min-height:42px;padding:0 12px;border:1px solid #e4e7ec;border-radius:7px;outline:none;color:#1f2937;background:#fff;font-size:14px;transition:border-color .16s,box-shadow .16s}.aa-modal input[type=password]:focus{border-color:rgba(37,99,235,.55);box-shadow:0 0 0 3px rgba(37,99,235,.1)}.aa-modal-error{margin:8px 0 0;color:#b42318;font-siz