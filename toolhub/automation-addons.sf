 could not be loaded.\", e); return []; }\n}\n\nfunction saveAutomationRules() {\n  try { if (typeof localStorage !== \"undefined\") localStorage.setItem(\"stockflow-automation-rules-v1\", JSON.stringify(_s.automationRules)); } catch (e) { console.warn(\"Automation rules could not be saved.\", e); }\n}\n\nfunction loadAddons() {\n  try {\n    if (typeof localStorage === \"undefined\") return [];\n    var saved = JSON.parse(localStorage.getItem(\"stockflow-addons-v1\") || \"[]\");\n    if (!Array.isArray(saved)) return [];\n    return saved.filter(function(addon) { return addon && typeof addon === \"object\"; }).map(function(addon) {\n      return { id: String(addon.id || \"addon-\" + Date.now() + \"-\" + Math.random().toString(36).slice(2)), name: String(addon.name || \"Untitled addon\"), description: String(addon.description || \"\"), code: String(addon.code || \"\"), enabled: addon.enabled !== false, autoRun: addon.autoRun === true, lastRunAt: String(addon.lastRunAt || \"\"), lastResult: String(addon.lastResult || \"\"), lastAffected: Number(addon.lastAffected) || 0, encryptedCode: addon.encryptedCode || null, passwordHash: addon.passwordHash || null };\n    });\n  } catch (e) { console.warn(\"Addons could not be loaded.\", e); return []; }\n}\n\nfunction saveAddons() {\n  try { if (typeof localStorage !== \"undefined\") localStorage.setItem(\"stockflow-addons-v1\", JSON.stringify(_s.addons)); } catch (e) { console.warn(\"Addons could not be saved.\", e); }\n}\n\nasync function deriveCryptoKey(password, salt) {\n  var encoder = new TextEncoder();\n  var keyMaterial = await crypto.subtle.importKey(\"raw\", encoder.encode(password), \"PBKDF2\", false, [\"deriveKey\"]);\n  return crypto.subtle.deriveKey({ name: \"PBKDF2\", salt: salt, iterations: 100000, hash: \"SHA-256\" }, keyMaterial, { name: \"AES-GCM\", length: 256 }, false, [\"encrypt\", \"decrypt\"]);\n}\n\nasync function encryptAddonCode(code, password) {\n  var encoder = new TextEncoder();\n  var salt = cryp