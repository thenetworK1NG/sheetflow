{
  "format": "sheetflow-tool",
  "version": 1,
  "tool": {
    "id": "summary",
    "name": "Summary",
    "icon": "\u25A6",
    "description": "Shows a collapsible summary of visible rows, hidden rows, groups, and value totals.",
    "author": "Sheetflow",
    "version": "1.0.0",
    "code": "var _sf = { refs: {}, state: {} };\n\nregisterTool({\n  id: \"summary\",\n  name: \"Summary\",\n  icon: \"\\u25A6\",\n  description: \"Collapsible stats summary panel.\",\n\n  activate() {\n    var style = document.createElement(\"style\");\n    style.id = \"summary-style\";\n    style.textContent = \n      \".sf-stats-grid { padding: 20px 24px; }\" +\n      \".sf-stats-grid .sf-stats-body { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 11px; transition: grid-template-rows .24s cubic-bezier(.4,0,.2,1), opacity .2s; }\" +\n      \".sf-stats-grid.sf-stats-collapsed .sf-stats-body { grid-template-rows: 0fr; opacity: 0; overflow: hidden; }\" +\n      \".sf-stats-grid .sf-stats-body > * { overflow: hidden; }\" +\n      \".sf-stats-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }\" +\n      \".sf-stats-toggle { display: grid; place-items: center; width: 28px; height: 28px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel-raised); color: var(--muted); cursor: pointer; transition: transform .24s cubic-bezier(.4,0,.2,1), color .14s, background .14s, border-color .14s; }\" +\n      \".sf-stats-toggle:hover { color: var(--text); background: var(--panel); border-color: rgba(37, 99, 235, .25); }\" +\n      \".sf-stats-collapsed .sf-stats-toggle { transform: rotate(-90deg); color: var(--blue); }\" +\n      \".sf-stat-card { position: relative; min-height: 112px; padding: 18px 17px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); transition: border-color .16s, box-shadow .16s; }\" +\n      \".sf-stat-card:hover { border-color: rgba(37, 99, 235, .22); box-shadow: 0 2px 8px rgba(16, 24, 40, .05); }\" +\n      \".sf-stat-value { display: block; margin: 10px 0 6px; font-size: 28px; font-weight: 750; letter-spacing: -.04em; color: var(--text); }\" +\n      \".sf-stat-foot { display: block; color: var(--muted); font-size: 12px; }\";\n    document.head.appendChild(style);\n\n    var slot = document.getElementById(\"toolPanelsSlot\");\n    slot.innerHTML = \n      '<section class=\"sf-stats-grid\" id=\"sfStatsGrid\">' +\n        '<div class=\"sf-stats-head\">' +\n          '<span class=\"section-kicker\">Summary</span>' +\n          '<button class=\"sf-stats-toggle\" id=\"sfStatsToggle\" type=\"button\" title=\"Toggle summary\" aria-label=\"Toggle summary\">' +\n            '<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>' +\n          '</button>' +\n        '</div>' +\n        '<div class=\"sf-stats-body\">' +\n          '<article class=\"sf-stat-card\"><span class=\"stat-label\">Visible rows</span><strong class=\"sf-stat-value\" id=\"sfVisibleStat\">0</strong><span class=\"sf-stat-foot\" id=\"sfVisibleStatFoot\">Nothing imported yet</span></article>' +\n          '<article class=\"sf-stat-card\"><span class=\"stat-label\">Hidden rows</span><strong class=\"sf-stat-value\" id=\"sfHiddenStat\">0</strong><span class=\"sf-stat-foot\" id=\"sfHiddenStatFoot\">Ready to view</span></article>' +\n          '<article class=\"sf-stat-card\"><span class=\"stat-label\">Groups found</span><strong class=\"sf-stat-value\" id=\"sfDuplicateStat\">0</strong><span class=\"sf-stat-foot\" id=\"sfDuplicateStatFoot\">Grouped by field</span></article>' +\n          '<article class=\"sf-stat-card\"><span class=\"stat-label\">Value in view</span><strong class=\"sf-stat-value\" id=\"sfQuantityStat\">-</strong><span class=\"sf-stat-foot\" id=\"sfQuantityStatFoot\">No value selected</span></article>' +\n        '</div>' +\n      '</section>';\n\n    _sf.refs.grid = document.getElementById(\"sfStatsGrid\");\n    _sf.refs.toggle = document.getElementById(\"sfStatsToggle\");\n    _sf.refs.visible = document.getElementById(\"sfVisibleStat\");\n    _sf.refs.visibleFoot = document.getElementById(\"sfVisibleStatFoot\");\n    _sf.refs.hidden = document.getElementById(\"sfHiddenStat\");\n    _sf.refs.hiddenFoot = document.getElementById(\"sfHiddenStatFoot\");\n    _sf.refs.duplicate = document.getElementById(\"sfDuplicateStat\");\n    _sf.refs.duplicateFoot = document.getElementById(\"sfDuplicateStatFoot\");\n    _sf.refs.quantity = document.getElementById(\"sfQuantityStat\");\n    _sf.refs.quantityFoot = document.getElementById(\"sfQuantityStatFoot\");\n\n    var self = this;\n    _sf.refs.toggle.addEventListener(\"click\", function () {\n      var collapsed = _sf.refs.grid.classList.toggle(\"sf-stats-collapsed\");\n      try { localStorage.setItem(\"sheetflow-summary-collapsed\", collapsed ? \"1\" : \"0\"); } catch (e) {}\n    });\n\n    try {\n      if (localStorage.getItem(\"sheetflow-summary-collapsed\") === \"1\") {\n        _sf.refs.grid.classList.add(\"sf-stats-collapsed\");\n      }\n    } catch (e) {}\n\n    chainRefresh(function () { self._update(); });\n    this._update();\n  },\n\n  deactivate() {\n    unchainRefresh(this._update);\n    var style = document.getElementById(\"summary-style\");\n    if (style) style.remove();\n    var slot = document.getElementById(\"toolPanelsSlot\");\n    if (slot) slot.innerHTML = \"\";\n    _sf.refs = {};\n  },\n\n  _update() {\n    var sheet = currentSheet();\n    if (!sheet) {\n      _sf.refs.visible.textContent = \"0\";\n      _sf.refs.hidden.textContent = \"0\";\n      _sf.refs.duplicate.textContent = \"0\";\n      _sf.refs.quantity.textContent = \"-\";\n      _sf.refs.visibleFoot.textContent = \"Nothing imported yet\";\n      _sf.refs.hiddenFoot.textContent = \"Ready to view\";\n      _sf.refs.duplicateFoot.textContent = \"Grouped by field\";\n      _sf.refs.quantityFoot.textContent = \"No value selected\";\n      return;\n    }\n    var groups = buildGroups(sheet);\n    var visible = sheet.rows.filter(function (row) { return !row.hidden; });\n    var duplicateGroups = Array.from(groups.values()).filter(function (group) { return group.rows.length > 1; }).length;\n    _sf.refs.visible.textContent = formatNumber(visible.length);\n    _sf.refs.hidden.textContent = formatNumber(sheet.rows.length - visible.length);\n    _sf.refs.duplicate.textContent = formatNumber(duplicateGroups);\n    _sf.refs.visibleFoot.textContent = formatNumber(sheet.rows.length) + \" total sheet rows\";\n    _sf.refs.hiddenFoot.textContent = sheet.rows.length - visible.length ? \"Excluded from export\" : \"Nothing hidden yet\";\n    _sf.refs.duplicateFoot.textContent = \"Grouped by \" + groupingLabel(sheet);\n    if (sheet.quantityColumn === null) {\n      _sf.refs.quantity.textContent = \"-\";\n      _sf.refs.quantityFoot.textContent = \"No numeric value column found\";\n    } else {\n      var total = visible.map(function (row) { return parseNumber(row.values[sheet.quantityColumn]); }).filter(function (v) { return v !== null; }).reduce(function (s, v) { return s + v; }, 0);\n      _sf.refs.quantity.textContent = formatNumber(total);\n      _sf.refs.quantityFoot.textContent = \"Visible \" + valueFieldLabel(sheet) + \" total\";\n    }\n  }\n});"
  }
}
