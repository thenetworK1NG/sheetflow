{
  "format": "sheetflow-tool",
  "version": 1,
  "tool": {
    "id": "find-replace",
    "name": "Find & Replace",
    "icon": "⇄",
    "description": "Search and replace text across all cells in the spreadsheet.",
    "author": "Sheetflow",
    "version": "1.0.0",
    "code": "(function() {\nvar _frStyle = document.createElement(\"style\");\n_frStyle.textContent = \".tool-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;padding:10px 23px;border-bottom:1px solid rgba(37,99,235,.18);background:rgba(37,99,235,.09)}.tool-controls-label{display:inline-flex;align-items:center;gap:5px;color:#667085;font-size:11px;font-weight:750}.tool-controls-input{min-height:31px;padding:0 8px;border:1px solid #e4e7ec;border-radius:7px;outline:none;color:#1f2937;background:#fff;font-size:11px;width:150px}.tool-controls-input:focus{border-color:rgba(37,99,235,.55);box-shadow:0 0 0 3px rgba(37,99,235,.1)}td[data-match]{background:rgba(37,99,235,.12)!important}td[data-match='current']{background:rgba(37,99,235,.25)!important;outline:2px solid #2563eb;outline-offset:-2px}\";\ndocument.head.appendChild(_frStyle);\n\nvar _fr = { _controls: null, _matches: [], _currentIndex: -1, _hook: null };\n\nfunction clearHighlights() {\n  refs.tableBody.querySelectorAll(\"td[data-match]\").forEach(function(td) { td.removeAttribute(\"data-match\"); });\n}\n\nfunction highlightMatches() {\n  clearHighlights();\n  _fr._matches = [];\n  _fr._currentIndex = -1;\n  var sheet = currentSheet();\n  if (!sheet || !_fr._controls) return;\n  var findInput = _fr._controls.querySelector(\"#frFindInput\");\n  var matchCase = _fr._controls.querySelector(\"#frMatchCase\");\n  var matchCount = _fr._controls.querySelector(\"#frMatchCount\");\n  var query = findInput.value;\n  if (!query) { matchCount.textContent = \"0 matches\"; return; }\n  var queryNorm = matchCase.checked ? query : normalizeText(query);\n  refs.tableBody.querySelectorAll(\"td[data-cell-row]\").forEach(function(td) {\n    var rowId = td.dataset.cellRow;\n    var colIndex = Number(td.dataset.cellColumn);\n    var row = sheet.rows.find(function(r) { return r.id === rowId; });\n    if (!row) return;\n    var val = valueToString(row.values[colIndex]);\n    var valNorm = matchCase.checked ? val : normalizeText(val);\n    if (valNorm.indexOf(queryNorm) !== -1) {\n      td.setAttribute(\"data-match\", \"true\");\n      _fr._matches.push({ td: td, rowId: rowId, colIndex: colIndex });\n    }\n  });\n  if (_fr._matches.length > 0) {\n    _fr._currentIndex = 0;\n    _fr._matches[0].td.setAttribute(\"data-match\", \"current\");\n  }\n  matchCount.textContent = _fr._matches.length + \" match\" + (_fr._matches.length !== 1 ? \"es\" : \"\");\n}\n\nfunction findNext() {\n  if (!_fr._matches.length) return;\n  var prev = refs.tableBody.querySelector(\"td[data-match='current']\");\n  if (prev) prev.setAttribute(\"data-match\", \"true\");\n  _fr._currentIndex = (_fr._currentIndex + 1) % _fr._matches.length;\n  _fr._matches[_fr._currentIndex].td.setAttribute(\"data-match\", \"current\");\n  _fr._matches[_fr._currentIndex].td.scrollIntoView({ block: \"center\", behavior: \"smooth\" });\n}\n\nfunction replaceCurrent() {\n  if (_fr._currentIndex < 0) return;\n  var match = _fr._matches[_fr._currentIndex];\n  var sheet = currentSheet();\n  if (!sheet) return;\n  var row = sheet.rows.find(function(r) { return r.id === match.rowId; });\n  if (!row) return;\n  var query = _fr._controls.querySelector(\"#frFindInput\").value;\n  var replacement = _fr._controls.querySelector(\"#frReplaceInput\").value;\n  var matchCase = _fr._controls.querySelector(\"#frMatchCase\").checked;\n  var val = valueToString(row.values[match.colIndex]);\n  var newVal;\n  if (matchCase) {\n    newVal = val.split(query).join(replacement);\n  } else {\n    newVal = val.replace(new RegExp(query.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\"), \"gi\"), replacement);\n  }\n  row.values[match.colIndex] = newVal;\n  row.searchText = row.values.map(normalizeText).join(\" \");\n  refresh();\n}\n\nfunction replaceAll() {\n  if (!_fr._matches.length) return;\n  var sheet = currentSheet();\n  if (!sheet) return;\n  var query = _fr._controls.querySelector(\"#frFindInput\").value;\n  var replacement = _fr._controls.querySelector(\"#frReplaceInput\").value;\n  var matchCase = _fr._controls.querySelector(\"#frMatchCase\").checked;\n  var count = 0;\n  _fr._matches.forEach(function(match) {\n    var row = sheet.rows.find(function(r) { return r.id === match.rowId; });\n    if (!row) return;\n    var val = valueToString(row.values[match.colIndex]);\n    var newVal;\n    if (matchCase) {\n      newVal = val.split(query).join(replacement);\n    } else {\n      newVal = val.replace(new RegExp(query.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\"), \"gi\"), replacement);\n    }\n    if (newVal !== val) {\n      row.values[match.colIndex] = newVal;\n      row.searchText = row.values.map(normalizeText).join(\" \");\n      count++;\n    }\n  });\n  refresh();\n  showToast(\"Replaced \" + count + \" cell\" + (count !== 1 ? \"s\" : \"\"), \"success\");\n}\n\n_fr._hook = function() { highlightMatches(); };\n\nfunction createControls() {\n  var div = document.createElement(\"div\");\n  div.className = \"tool-controls\";\n  div.innerHTML = '<label class=\"tool-controls-label\">Find <input type=\"text\" id=\"frFindInput\" class=\"tool-controls-input\" placeholder=\"Search text...\"></label>'\n    + '<label class=\"tool-controls-label\">Replace <input type=\"text\" id=\"frReplaceInput\" class=\"tool-controls-input\" placeholder=\"Replace with...\"></label>'\n    + '<label style=\"display:inline-flex;align-items:center;gap:5px;color:#667085;font-size:11px;font-weight:750;\"><input type=\"checkbox\" id=\"frMatchCase\" style=\"width:14px;height:14px;\"><span>Match case</span></label>'\n    + '<button class=\"button button-quiet button-small\" id=\"frFindNext\" type=\"button\">Find next</button>'\n    + '<button class=\"button button-quiet button-small\" id=\"frReplace\" type=\"button\">Replace</button>'\n    + '<button class=\"button button-primary button-small\" id=\"frReplaceAll\" type=\"button\">Replace all</button>'\n    + '<span id=\"frMatchCount\" style=\"display:inline-flex;align-items:center;min-height:18px;padding:0 6px;border-radius:5px;color:#2563eb;background:rgba(37,99,235,.09);font-size:9px;font-weight:750;\">0 matches</span>';\n  var toolBar = document.getElementById(\"toolBar\");\n  if (toolBar) toolBar.parentNode.insertBefore(div, toolBar.nextSibling);\n  else { var ws = document.querySelector(\".workspace\"); if (ws) ws.insertBefore(div, ws.firstChild); }\n  _fr._controls = div;\n  div.querySelector(\"#frFindInput\").addEventListener(\"input\", function() { highlightMatches(); });\n  div.querySelector(\"#frMatchCase\").addEventListener(\"change\", function() { highlightMatches(); });\n  div.querySelector(\"#frFindNext\").addEventListener(\"click\", function() { findNext(); });\n  div.querySelector(\"#frReplace\").addEventListener(\"click\", function() { replaceCurrent(); });\n  div.querySelector(\"#frReplaceAll\").addEventListener(\"click\", function() { replaceAll(); });\n  div.querySelector(\"#frFindInput\").addEventListener(\"keydown\", function(e) { if (e.key === \"Enter\") { e.preventDefault(); findNext(); } });\n  div.querySelector(\"#frReplaceInput\").addEventListener(\"keydown\", function(e) { if (e.key === \"Enter\") { e.preventDefault(); replaceCurrent(); } });\n  div.querySelector(\"#frFindInput\").focus();\n}\n\nfunction removeControls() {\n  if (_fr._controls) { _fr._controls.remove(); _fr._controls = null; }\n}\n\nregisterTool({\n  id: \"find-replace\",\n  name: \"Find & Replace\",\n  icon: \"\\u21C4\",\n  description: \"Search and replace text across all cells in the spreadsheet.\",\n  activate: function() {\n    _fr._matches = [];\n    _fr._currentIndex = -1;\n    createControls();\n    chainRefresh(_fr._hook);\n    highlightMatches();\n  },\n  deactivate: function() {\n    unchainRefresh(_fr._hook);\n    clearHighlights();\n    removeControls();\n  }\n});\n})();"
  }
}