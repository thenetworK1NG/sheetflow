{
  "format": "sheetflow-tool",
  "version": 1,
  "tool": {
    "id": "search-filter",
    "name": "Search & Filter",
    "icon": "*",
    "description": "Search rows by text, filter by scope, sort by column.",
    "author": "Sheetflow",
    "version": "1.0.0",
    "code": "(function() {\n  var _sf = { refs: {}, state: {}, _hook: null };\n  _sf.state = { search: \"\", searchNormalized: \"\", scope: \"active\", includeHidden: false, sort: \"original\" };\n  function injectUI() {\n    var slot = document.getElementById(\"toolPanelsSlot\");\n    if (!slot) return;\n    var div = document.createElement(\"div\");\n    div.id = \"_sf_panel\";\n    div.style.cssText = \"margin-bottom:16px;padding:14px 18px;border:1px solid var(--line);border-radius:10px;background:var(--panel);\";\n    div.innerHTML = '<div style=\"display:flex;align-items:center;gap:10px;flex-wrap:wrap;\">'\n      + '<label style=\"font-size:11px;font-weight:700;color:var(--muted);\">Search:</label>'\n      + '<input id=\"_sf_search\" type=\"text\" placeholder=\"Search any cell...\" style=\"flex:1;min-width:180px;padding:8px 12px;border:1px solid var(--line);border-radius:7px;font-size:12px;\">'\n      + '<label style=\"font-size:11px;font-weight:700;color:var(--muted);\">Scope:</label>'\n      + '<select id=\"_sf_scope\" style=\"padding:8px 12px;border:1px solid var(--line);border-radius:7px;font-size:12px;\">'\n      + '<option value=\"active\">Active rows</option><option value=\"hidden\">Hidden rows</option><option value=\"duplicates\">Duplicates</option></select>'\n      + '<label style=\"display:inline-flex;align-items:center;gap:6px;font-size:11px;cursor:pointer;\"><input id=\"_sf_includeHidden\" type=\"checkbox\" style=\"width:14px;height:14px;\"> Include hidden</label>'\n      + '<label style=\"font-size:11px;font-weight:700;color:var(--muted);\">Sort:</label>'\n      + '<select id=\"_sf_sort\" style=\"padding:8px 12px;border:1px solid var(--line);border-radius:7px;font-size:12px;\">'\n      + '<option value=\"original\">Original order</option><option value=\"product\">By name</option><option value=\"quantity\">By value</option></select>'\n      + '</div>';\n    slot.appendChild(div);\n    _sf.refs.search = document.getElementById(\"_sf_search\");\n    _sf.refs.scope = document.getElementById(\"_sf_scope\");\n    _sf.refs.includeHidden = document.getElementById(\"_sf_includeHidden\");\n    _sf.refs.sort = document.getElementById(\"_sf_sort\");\n  }\n  function matchesSearch(row) {\n    var query = _sf.state.searchNormalized;\n    if (!query) return true;\n    var text = (row.searchText || row.values.map(normalizeText).join(\" \"));\n    return text.includes(query) || String(row.sourceRowNumber).includes(query);\n  }\n  function matchesScope(row, group) {\n    if (_sf.state.scope === \"active\") return !row.hidden || _sf.state.includeHidden;\n    if (_sf.state.scope === \"hidden\") return row.hidden;\n    if (_sf.state.scope === \"duplicates\") return group.rows.length > 1 && (!row.hidden || _sf.state.includeHidden);\n    return true;\n  }\n  function compareRows(first, second, sheet) {\n    if (_sf.state.sort === \"product\") {\n      var c = normalizeText(valueToString(first.values[0])).localeCompare(normalizeText(valueToString(second.values[0])), undefined, { numeric: true });\n      if (c) return c;\n    }\n    if (_sf.state.sort === \"quantity\" && sheet.quantityColumn !== null) {\n      var a = parseNumber(first.values[sheet.quantityColumn]);\n      var b = parseNumber(second.values[sheet.quantityColumn]);\n      var diff = (b === null ? -Infinity : b) - (a === null ? -Infinity : a);\n      if (diff) return diff;\n    }\n    return first.sourceIndex - second.sourceIndex;\n  }\n  function getFilteredRows(sheet) {\n    var groups = buildGroups(sheet);\n    return sheet.rows.filter(function(row) { return matchesScope(row, groups.get(duplicateKey(row, sheet))) && matchesSearch(row); }).sort(function(a, b) { return compareRows(a, b, sheet); });\n  }\n  _sf._hook = function() {\n    var sheet = currentSheet();\n    if (!sheet || !_sf.refs.search) return;\n    var filtered = getFilteredRows(sheet);\n    var groups = buildGroups(sheet);\n    var visibleItems = pageItems(filtered);\n    refs.tableHead.innerHTML = \"<tr><th class='row-number'>#</th>\" + sheet.headers.map(function(h) { return \"<th>\" + escapeHTML(h) + \"</th>\"; }).join(\"\") + \"<th>Match</th></tr>\";\n    refs.tableBody.innerHTML = visibleItems.map(function(row) {\n      var group = groups.get(duplicateKey(row, sheet));\n      var count = group.rows.length;\n      var match = count > 1 ? '<span style=\"display:inline-flex;padding:0 6px;border-radius:5px;background:rgba(37,99,235,.09);color:#2563eb;font-size:10px;font-weight:750;\">' + count + ' matches</span>' : '<span style=\"display:inline-flex;padding:0 6px;border-radius:5px;background:#f2f4f7;color:#98a2b3;font-size:10px;font-weight:750;\">Unique</span>';\n      var hiddenBadge = row.hidden ? '<span style=\"display:inline-flex;padding:0 6px;border-radius:5px;background:rgba(180,35,24,.08);color:#b42318;font-size:10px;font-weight:750;margin-left:4px;\">excluded</span>' : \"\";\n      return '<tr class=\"' + (row.hidden ? 'is-hidden' : '') + '\"><td class=\"row-number-cell\">' + row.sourceRowNumber + '</td>' + row.values.map(function(v, i) { return '<td data-cell-row=\"' + escapeHTML(row.id) + '\" data-cell-column=\"' + i + '\">' + formatCell(v) + '</td>'; }).join(\"\") + '<td>' + match + hiddenBadge + '</td></tr>';\n    }).join(\"\");\n    refs.resultCount.textContent = filtered.length + \" row\" + (filtered.length === 1 ? \"\" : \"s\") + \" shown\";\n  };\n  function bindEvents() {\n    _sf.refs.search.addEventListener(\"input\", function() { _sf.state.search = _sf.refs.search.value; _sf.state.searchNormalized = normalizeText(_sf.state.search); resetPage(); refresh(); });\n    _sf.refs.scope.addEventListener(\"change\", function() { _sf.state.scope = _sf.refs.scope.value; resetPage(); refresh(); });\n    _sf.refs.includeHidden.addEventListener(\"change\", function() { _sf.state.includeHidden = _sf.refs.includeHidden.checked; resetPage(); refresh(); });\n    _sf.refs.sort.addEventListener(\"change\", function() { _sf.state.sort = _sf.refs.sort.value; resetPage(); refresh(); });\n  }\n  function removeUI() { var panel = document.getElementById(\"_sf_panel\"); if (panel) panel.remove(); _sf.refs = {}; }\n    registerTool({ id: \"search-filter\", name: \"Search & Filter\", icon: \"*\", description: \"Search rows by text, filter by scope, sort by column.\",\n    activate() { injectUI(); bindEvents(); chainRefresh(_sf._hook); refresh(); },\n    deactivate() { removeUI(); unchainRefresh(_sf._hook); refresh(); }\n  });\n})();"
  }
}