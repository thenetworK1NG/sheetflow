{
  "format": "sheetflow-tool",
  "version": 1,
  "tool": {
    "id": "sort-group",
    "name": "Sort & Group",
    "icon": "⇵",
    "description": "View rows grouped by any field. Sort by name, value, or original order.",
    "author": "Sheetflow",
    "version": "1.0.0",
    "code": "(function() {\n  var _sg = { refs: {}, state: {}, _hook: null };\n  _sg.state = { view: \"rows\", sort: \"original\" };\n  function injectUI() {\n    var slot = document.getElementById(\"toolPanelsSlot\");\n    if (!slot) return;\n    var div = document.createElement(\"div\");\n    div.id = \"_sg_panel\";\n    div.style.cssText = \"margin-bottom:16px;padding:14px 18px;border:1px solid var(--line);border-radius:10px;background:var(--panel);\";\n    div.innerHTML = '<div style=\"display:flex;align-items:center;gap:10px;flex-wrap:wrap;\">'\n      + '<div style=\"display:inline-flex;padding:3px;border:1px solid var(--line);border-radius:8px;background:#f8fafc;\">'\n      + '<button id=\"_sg_rows\" type=\"button\" style=\"padding:6px 14px;border-radius:7px;border:0;background:var(--panel);font-size:11px;font-weight:750;cursor:pointer;box-shadow:0 2px 8px rgba(16,24,40,.1);color:#2563eb;\">Rows</button>'\n      + '<button id=\"_sg_groups\" type=\"button\" style=\"padding:6px 14px;border-radius:7px;border:0;background:transparent;font-size:11px;font-weight:750;cursor:pointer;color:#667085;\">Grouped</button>'\n      + '</div>'\n      + '<label style=\"font-size:11px;font-weight:700;color:var(--muted);\">Sort:</label>'\n      + '<select id=\"_sg_sort\" style=\"padding:8px 12px;border:1px solid var(--line);border-radius:7px;font-size:12px;\">'\n      + '<option value=\"original\">Original order</option><option value=\"product\">By name</option><option value=\"quantity\">By value</option></select>'\n      + '</div>';\n    slot.appendChild(div);\n    _sg.refs.rowsBtn = document.getElementById(\"_sg_rows\");\n    _sg.refs.groupsBtn = document.getElementById(\"_sg_groups\");\n    _sg.refs.sort = document.getElementById(\"_sg_sort\");\n  }\n  function displayRows(sheet, groups) {\n    return sheet.rows.slice().sort(function(a, b) { return compareRowsCustom(a, b, sheet); });\n  }\n  function displayGroups(sheet, groups) {\n    return Array.from(groups.values()).sort(function(a, b) { return compareGroups(a, b, sheet); });\n  }\n  function compareRowsCustom(first, second, sheet) {\n    if (_sg.state.sort === \"product\") {\n      var c = normalizeText(valueToString(first.values[0])).localeCompare(normalizeText(valueToString(second.values[0])), undefined, { numeric: true });\n      if (c) return c;\n    }\n    if (_sg.state.sort === \"quantity\" && sheet.quantityColumn !== null) {\n      var a = parseNumber(first.values[sheet.quantityColumn]);\n      var b = parseNumber(second.values[sheet.quantityColumn]);\n      var diff = (b === null ? -Infinity : b) - (a === null ? -Infinity : a);\n      if (diff) return diff;\n    }\n    return first.sourceIndex - second.sourceIndex;\n  }\n  function compareGroups(first, second, sheet) {\n    if (_sg.state.sort === \"quantity\") {\n      var a = 0, b = 0;\n      if (sheet.quantityColumn !== null) {\n        a = first.rows.reduce(function(s, r) { var v = parseNumber(r.values[sheet.quantityColumn]); return s + (v || 0); }, 0);\n        b = second.rows.reduce(function(s, r) { var v = parseNumber(r.values[sheet.quantityColumn]); return s + (v || 0); }, 0);\n      }\n      if (b !== a) return b - a;\n    }\n    if (_sg.state.sort === \"product\") return groupLabel(first, sheet).localeCompare(groupLabel(second, sheet), undefined, { numeric: true });\n    return first.rows[0].sourceIndex - second.rows[0].sourceIndex;\n  }\n  function groupQuantity(group, sheet, hideZero) {\n    if (sheet.quantityColumn === null) return \"-\";\n    var total = group.rows.reduce(function(s, r) { var v = parseNumber(r.values[sheet.quantityColumn]); return s + (v || 0); }, 0);\n    if (hideZero && total === 0) return \"-\";\n    return formatNumber(total);\n  }\n  _sg._hook = function() {\n    var sheet = currentSheet();\n    if (!sheet || !_sg.refs.rowsBtn) return;\n    var groups = buildGroups(sheet);\n    if (_sg.state.view === \"rows\") {\n      var items = displayRows(sheet, groups);\n      var visibleItems = pageItems(items);\n      refs.tableHead.innerHTML = \"<tr><th class='row-number'>#</th>\" + sheet.headers.map(function(h) { return \"<th>\" + escapeHTML(h) + \"</th>\"; }).join(\"\") + \"<th>Matches</th></tr>\";\n      refs.tableBody.innerHTML = visibleItems.map(function(row) {\n        var group = groups.get(duplicateKey(row, sheet));\n        var count = group.rows.length;\n        var match = count > 1 ? '<span style=\"display:inline-flex;padding:0 6px;border-radius:5px;background:rgba(37,99,235,.09);color:#2563eb;font-size:10px;font-weight:750;\">' + count + ' matches</span>' : '<span style=\"display:inline-flex;padding:0 6px;border-radius:5px;background:#f2f4f7;color:#98a2b3;font-size:10px;font-weight:750;\">Unique</span>';\n        return '<tr><td class=\"row-number-cell\">' + row.sourceRowNumber + '</td>' + row.values.map(function(v, i) { return '<td data-cell-row=\"' + escapeHTML(row.id) + '\" data-cell-column=\"' + i + '\">' + formatCell(v) + '</td>'; }).join(\"\") + '<td>' + match + '</td></tr>';\n      }).join(\"\");\n      refs.resultCount.textContent = items.length + \" row\" + (items.length === 1 ? \"\" : \"s\") + \" shown\";\n    } else {\n      var visibleGroups = displayGroups(sheet, groups);\n      var visibleItems2 = pageItems(visibleGroups);\n      refs.tableHead.innerHTML = \"<tr><th class='row-number'>#</th>\" + '<th>' + escapeHTML(groupingFieldLabel(sheet)) + ' group</th>' + '<th>Matches</th>' + '<th>Visible ' + escapeHTML(valueFieldLabel(sheet)) + '</th>' + '<th>Original rows</th></tr>';\n      refs.tableBody.innerHTML = visibleItems2.map(function(group) {\n        var lines = group.rows.map(function(r) { return \"#\" + r.sourceRowNumber; }).join(\", \");\n        var hiddenCount = group.rows.filter(function(r) { return r.hidden; }).length;\n        return '<tr><td class=\"row-number-cell\"><button class=\"expand-button\" type=\"button\" aria-expanded=\"false\">&gt;</button></td>' + '<td><strong>' + escapeHTML(groupLabel(group, sheet)) + '</strong></td>' + '<td>' + group.rows.length + '</td>' + '<td>' + groupQuantity(group, sheet, true) + (hiddenCount ? ' <span style=\"display:inline-flex;padding:0 6px;border-radius:5px;background:rgba(180,35,24,.08);color:#b42318;font-size:10px;font-weight:750;\">' + hiddenCount + ' hidden</span>' : '') + '</td>' + '<td style=\"color:var(--faint);font-size:10px;\">' + escapeHTML(lines) + '</td></tr>';\n      }).join(\"\");\n      refs.resultCount.textContent = visibleGroups.length + \" group\" + (visibleGroups.length === 1 ? \"\" : \"s\") + \" shown\";\n    }\n  };\n  function bindEvents() {\n    _sg.refs.rowsBtn.addEventListener(\"click\", function() {\n      _sg.state.view = \"rows\";\n      _sg.refs.rowsBtn.style.background = \"var(--panel)\";\n      _sg.refs.rowsBtn.style.color = \"#2563eb\";\n      _sg.refs.rowsBtn.style.boxShadow = \"0 2px 8px rgba(16,24,40,.1)\";\n      _sg.refs.groupsBtn.style.background = \"transparent\";\n      _sg.refs.groupsBtn.style.color = \"#667085\";\n      _sg.refs.groupsBtn.style.boxShadow = \"none\";\n      resetPage();\n      refresh();\n    });\n    _sg.refs.groupsBtn.addEventListener(\"click\", function() {\n      _sg.state.view = \"groups\";\n      _sg.refs.groupsBtn.style.background = \"var(--panel)\";\n      _sg.refs.groupsBtn.style.color = \"#2563eb\";\n      _sg.refs.groupsBtn.style.boxShadow = \"0 2px 8px rgba(16,24,40,.1)\";\n      _sg.refs.rowsBtn.style.background = \"transparent\";\n      _sg.refs.rowsBtn.style.color = \"#667085\";\n      _sg.refs.rowsBtn.style.boxShadow = \"none\";\n      resetPage();\n      refresh();\n    });\n    _sg.refs.sort.addEventListener(\"change\", function() {\n      _sg.state.sort = _sg.refs.sort.value;\n      resetPage();\n      refresh();\n    });\n  }\n  function removeUI() { var panel = document.getElementById(\"_sg_panel\"); if (panel) panel.remove(); _sg.refs = {}; }\n    registerTool({ id: \"sort-group\", name: \"Sort & Group\", icon: \"\\u21F5\", description: \"View rows grouped by any field. Sort by name, value, or original order.\",\n    activate() { injectUI(); bindEvents(); chainRefresh(_sg._hook); refresh(); },\n    deactivate() { removeUI(); unchainRefresh(_sg._hook); refresh(); }\n  });\n})();"
  }
}