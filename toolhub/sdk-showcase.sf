{
  "format": "sheetflow-tool",
  "version": 1,
  "tool": {
    "id": "sdk-showcase",
    "name": "SDK Showcase",
    "icon": "✨",
    "description": "Interactive demo of everything the Sheetflow SDK can do. Adds buttons, dropdowns, sidebar panels, modals, keyboard shortcuts, and data hooks.",
    "author": "Sheetflow",
    "version": "1.0.0",
    "code": "registerTool({\n  id: \"sdk-showcase\",\n  name: \"SDK Showcase\",\n  icon: \"\\u2728\",\n\n  activate: function () {\n    var self = this;\n\n    sf.addTopbarButton({\n      id: \"showcase-modal\",\n      icon: \"\\u2728\",\n      label: \"Showcase\",\n      onClick: function () { self.openShowcaseModal(); }\n    });\n\n    sf.addTopbarDropdown({\n      id: \"showcase-menu\",\n      label: \"SDK Demo\",\n      items: [\n        { icon: \"\\u2b50\", label: \"Custom modal\", onClick: function () { self.openShowcaseModal(); } },\n        { icon: \"\\u2699\", label: \"Settings demo\", onClick: function () { self.openSettingsPrompt(); } },\n        { divider: true },\n        { icon: \"\\u2139\", label: \"About this tool\", onClick: function () { self.openAboutModal(); } },\n        { icon: \"\\ud83d\\udcca\", label: \"Data inspector\", onClick: function () { self.openDataInspector(); } }\n      ]\n    });\n\n    sf.setTopbarStatus(\"SDK Showcase active\", \"info\");\n\n    sf.addSidebarSection({\n      id: \"showcase-info\",\n      icon: \"\\u2728\",\n      label: \"SDK Showcase\",\n      content: self.buildSidebarContent()\n    });\n\n    sf.registerShortcut(\"Ctrl+Shift+D\", function () {\n      self.openShowcaseModal();\n    }, \"Open SDK Showcase modal\");\n\n    sf.registerShortcut(\"Ctrl+Shift+I\", function () {\n      self.openDataInspector();\n    }, \"Open data inspector\");\n\n    sf.registerShortcut(\"Ctrl+Shift+M\", function () {\n      self.cycleStatus();\n    }, \"Cycle topbar status demo\");\n\n    sf.on(\"sheet:loaded\", function (data) {\n      self.updateSidebar(\"Loaded: \" + data.fileName);\n      sf.showToast(\"SDK Showcase: new sheet loaded\", \"success\");\n    });\n\n    sf.on(\"data:modified\", function (data) {\n      self.updateSidebar(\"Last edit: \" + data.type);\n    });\n\n    sf.on(\"selection:changed\", function (data) {\n      var count = data.selectedIds.size;\n      self.updateSidebar(\"Selected: \" + count + \" row\" + (count === 1 ? \"\" : \"s\"));\n    });\n\n    sf.showToast(\"SDK Showcase active! Click the topbar or press Ctrl+Shift+D\", \"success\");\n  },\n\n  deactivate: function () {\n    sf.removeTopbarButton(\"showcase-modal\");\n    sf.removeTopbarDropdown(\"showcase-menu\");\n    sf.removeSidebarSection(\"showcase-info\");\n    sf.resetTopbarStatus();\n    sf.unregisterShortcut(\"Ctrl+Shift+D\");\n    sf.unregisterShortcut(\"Ctrl+Shift+I\");\n    sf.unregisterShortcut(\"Ctrl+Shift+M\");\n    sf.off(\"sheet:loaded\");\n    sf.off(\"data:modified\");\n    sf.off(\"selection:changed\");\n    sf.showToast(\"SDK Showcase deactivated.\", \"info\");\n  },\n\n  openShowcaseModal: function () {\n    var rows = sf.getVisibleRows();\n    var allRows = sf.getAllRows();\n    var selected = sf.getSelectedRows();\n\n    var html = \"<div style='font-family:inherit'>\"\n      + \"<p style='color:var(--muted);font-size:13px;line-height:1.7;margin:0 0 16px'>\"\n      + \"This modal was opened by <strong>sf.openModal()</strong>. \"\n      + \"Everything below is rendered by the SDK Showcase tool.</p>\"\n      + \"<div style='display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:20px'>\"\n      + statBox(\"All rows\", allRows.length, \"var(--ink)\")\n      + statBox(\"Visible\", rows.length, \"var(--green)\")\n      + statBox(\"Selected\", selected.length, \"var(--violet)\")\n      + \"</div>\"\n      + \"<h4 style='margin:0 0 8px;font-size:13px;font-weight:700;color:var(--ink)'>SDK capabilities demonstrated:</h4>\"\n      + \"<ul style='margin:0;padding:0 0 0 18px;color:var(--muted);font-size:12px;line-height:2'>\"\n      + \"<li><strong>sf.addTopbarButton</strong> \\u2014 the \\u2728 button</li>\"\n      + \"<li><strong>sf.addTopbarDropdown</strong> \\u2014 the SDK Demo menu</li>\"\n      + \"<li><strong>sf.setTopbarStatus</strong> \\u2014 changed the status bar</li>\"\n      + \"<li><strong>sf.addSidebarSection</strong> \\u2014 left sidebar panel</li>\"\n      + \"<li><strong>sf.openModal</strong> \\u2014 this dialog</li>\"\n      + \"<li><strong>sf.registerShortcut</strong> \\u2014 Ctrl+Shift+D / I / M</li>\"\n      + \"<li><strong>sf.on / sf.emit</strong> \\u2014 listening to sheet, data, selection events</li>\"\n      + \"<li><strong>sf.getVisibleRows / sf.getAllRows</strong> \\u2014 live data query</li>\"\n      + \"</ul></div>\";\n\n    sf.openModal({\n      title: \"SDK Showcase\",\n      content: html,\n      width: 560,\n      buttons: [\n        { label: \"Data inspector\", type: \"ghost\", onClick: function () {\n          setTimeout(function () { sf.openModal && openDataInspectorDirect(); }, 300);\n        }},\n        { label: \"Close\", type: \"primary\" }\n      ]\n    });\n  },\n\n  openDataInspector: function () {\n    var allRows = sf.getAllRows();\n    var visibleRows = sf.getVisibleRows();\n    var sheet = sf.currentSheet();\n\n    if (!sheet) {\n      sf.openModal({\n        title: \"Data Inspector\",\n        content: \"<p style='color:var(--muted);font-size:13px'>No sheet loaded. Import a file first.</p>\",\n        buttons: [{ label: \"OK\", type: \"primary\" }]\n      });\n      return;\n    }\n\n    var headers = sheet.headers || [];\n    var colCount = headers.length;\n    var hiddenCount = allRows.length - visibleRows.length;\n\n    var headerHtml = \"\";\n    if (headers.length > 0) {\n      headerHtml = \"<div style='display:flex;flex-wrap:wrap;gap:4px;margin-bottom:16px'>\";\n      for (var h = 0; h < headers.length; h++) {\n        headerHtml += \"<span style='display:inline-flex;align-items:center;gap:4px;padding:4px 8px;border-radius:5px;background:#f1f5f9;font-size:10px;color:var(--ink-soft);font-weight:600'>\"\n          + \"<span style='color:var(--faint);font-size:8px'>\" + (h + 1) + \"</span>\"\n          + sf.escapeHTML(headers[h]) + \"</span>\";\n      }\n      headerHtml += \"</div>\";\n    }\n\n    var previewRows = allRows.slice(0, 5);\n    var previewHtml = \"\";\n    if (previewRows.length > 0) {\n      previewHtml = \"<div style='border:1px solid var(--line);border-radius:6px;overflow:hidden;margin-bottom:12px'>\";\n      for (var p = 0; p < previewRows.length; p++) {\n        var row = previewRows[p];\n        var cells = row.values.map(function (v) { return sf.escapeHTML(sf.valueToString(v)); }).join(\" \\u00b7 \");\n        previewHtml += \"<div style='display:flex;border-top:1px solid var(--line);font-size:10px'>\"\n          + \"<span style='min-width:28px;padding:5px 6px;background:#fafbfd;color:var(--faint);font-weight:600;border-right:1px solid var(--line);text-align:center'>\" + (row.sourceRowNumber || \"?\") + \"</span>\"\n          + \"<span style='flex:1;padding:5px 8px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>\" + cells + \"</span>\"\n          + \"<span style='padding:5px 8px;color:\" + (row.hidden ? \"var(--faint)\" : \"var(--green)\") + \";font-weight:600'>\" + (row.hidden ? \"Hidden\" : \"Visible\") + \"</span>\"\n          + \"</div>\";\n      }\n      previewHtml += \"</div>\";\n    } else {\n      previewHtml = \"<p style='color:var(--muted);font-size:12px'>No rows to display.</p>\";\n    }\n\n    var html = \"<div style='font-family:inherit'>\"\n      + \"<div style='display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;margin-bottom:16px'>\"\n      + statBox(\"Rows\", allRows.length, \"var(--ink)\")\n      + statBox(\"Visible\", visibleRows.length, \"var(--green)\")\n      + statBox(\"Hidden\", hiddenCount, \"var(--faint)\")\n      + statBox(\"Columns\", colCount, \"var(--violet)\")\n      + \"</div>\"\n      + \"<h4 style='margin:0 0 6px;font-size:12px;font-weight:700;color:var(--ink)'>Columns</h4>\"\n      + headerHtml\n      + \"<h4 style='margin:0 0 6px;font-size:12px;font-weight:700;color:var(--ink)'>First 5 rows</h4>\"\n      + previewHtml\n      + \"<p style='margin:0;color:var(--faint);font-size:10px'>Queried via sf.getAllRows(), sf.getVisibleRows(), sf.currentSheet()</p>\"\n      + \"</div>\";\n\n    sf.openModal({\n      title: \"Data Inspector\",\n      content: html,\n      width: 600,\n      buttons: [{ label: \"Close\", type: \"primary\" }]\n    });\n  },\n\n  openSettingsPrompt: function () {\n    sf.prompt(\"Enter a value to demo sf.prompt():\", \"Hello from SDK\").then(function (value) {\n      if (value !== null) {\n        sf.showToast(\"sf.prompt() returned: \" + value, \"success\");\n        sf.emit(\"showcase:prompt\", { value: value });\n      } else {\n        sf.showToast(\"sf.prompt() was cancelled.\", \"info\");\n      }\n    });\n  },\n\n  openAboutModal: function () {\n    var self = this;\n    var html = \"<div style='font-family:inherit'>\"\n      + \"<div style='display:flex;align-items:center;gap:12px;margin-bottom:16px;padding:14px;border:1px solid var(--line);border-radius:10px;background:#fafbfd'>\"\n      + \"<span style='font-size:28px'>\\u2728</span>\"\n      + \"<div><strong style='font-size:15px;color:var(--ink)'>SDK Showcase</strong>\"\n      + \"<div style='color:var(--muted);font-size:11px;margin-top:2px'>v1.0.0 by Sheetflow</div></div>\"\n      + \"</div>\"\n      + \"<p style='color:var(--muted);font-size:12px;line-height:1.7;margin:0 0 12px'>\"\n      + \"This tool demonstrates every major feature of the Sheetflow SDK: \"\n      + \"<strong>topbar buttons</strong>, <strong>dropdowns</strong>, <strong>sidebar sections</strong>, \"\n      + \"<strong>modals</strong>, <strong>prompts</strong>, <strong>keyboard shortcuts</strong>, \"\n      + \"<strong>event subscriptions</strong>, and <strong>data API</strong> calls.</p>\"\n      + \"<div style='padding:10px 14px;border:1px solid var(--line);border-radius:8px;background:#fafbfd'>\"\n      + \"<div style='color:var(--faint);font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-bottom:6px'>Keyboard shortcuts</div>\"\n      + \"<div style='font-size:11px;color:var(--muted);line-height:1.8'>\"\n      + \"<div><kbd style='padding:2px 6px;border:1px solid var(--line);border-radius:4px;background:#fff;font-size:10px;font-family:monospace'>Ctrl+Shift+D</kbd> Open showcase modal</div>\"\n      + \"<div><kbd style='padding:2px 6px;border:1px solid var(--line);border-radius:4px;background:#fff;font-size:10px;font-family:monospace'>Ctrl+Shift+I</kbd> Data inspector</div>\"\n      + \"<div><kbd style='padding:2px 6px;border:1px solid var(--line);border-radius:4px;background:#fff;font-size:10px;font-family:monospace'>Ctrl+Shift+M</kbd> Cycle status demo</div>\"\n      + \"</div></div></div>\";\n\n    sf.openModal({\n      title: \"About SDK Showcase\",\n      content: html,\n      width: 480,\n      buttons: [\n        { label: \"Run confirm demo\", type: \"ghost\", onClick: function () {\n          setTimeout(function () { self.confirmDemo(); }, 300);\n        }},\n        { label: \"Close\", type: \"primary\" }\n      ]\n    });\n  },\n\n  confirmDemo: function () {\n    sf.confirm(\"This is sf.confirm(). Do you want to proceed?\").then(function (yes) {\n      if (yes) {\n        sf.showToast(\"sf.confirm() returned true\", \"success\");\n      } else {\n        sf.showToast(\"sf.confirm() returned false\", \"info\");\n      }\n    });\n  },\n\n  cycleStatus: function () {\n    var self = this;\n    if (!self._statusIndex) self._statusIndex = 0;\n    var count = sf.getVisibleRows().length;\n    var states = [\n      \"\\u2728 SDK Showcase active\",\n      \"\\u2699 Demo mode\",\n      \"\\ud83d\\udcca \" + count + \" visible rows\",\n      \"\\u2139 Keyboard shortcuts active\"\n    ];\n    var text = states[self._statusIndex % states.length];\n    sf.setTopbarStatus(text, \"info\");\n    sf.showToast(\"Status: \" + text, \"info\");\n    self._statusIndex++;\n  },\n\n  buildSidebarContent: function () {\n    var wrap = document.createElement(\"div\");\n    wrap.style.cssText = \"padding:4px 0;font-size:12px;color:var(--muted);line-height:1.7\";\n    wrap.innerHTML = \"<div style='margin-bottom:8px'><strong style='color:var(--ink);font-size:13px'>SDK Showcase</strong></div>\"\n      + \"<div style='margin-bottom:6px'>This panel is injected by <code style='padding:1px 4px;border-radius:3px;background:var(--blue-pale);color:var(--blue);font-size:10px'>sf.addSidebarSection()</code></div>\"\n      + \"<div id='sdk-showcase-live' style='padding:8px;border:1px solid var(--line);border-radius:6px;background:#fafbfd'>\"\n      + \"<div style='color:var(--faint);font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-bottom:4px'>Live info</div>\"\n      + \"<div style='font-size:11px;color:var(--muted)'>Import a sheet to see live updates.</div>\"\n      + \"</div>\";\n    return wrap;\n  },\n\n  updateSidebar: function (message) {\n    var el = document.getElementById(\"sdk-showcase-live\");\n    if (!el) return;\n    el.innerHTML = \"<div style='color:var(--faint);font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-bottom:4px'>Live info</div>\"\n      + \"<div style='font-size:11px;color:var(--muted);word-break:break-word'>\" + sf.escapeHTML(message) + \"</div>\"\n      + \"<div style='font-size:9px;color:var(--faint);margin-top:4px'>Updated via sf.on() events</div>\";\n  }\n});\n\nfunction statBox(label, value, color) {\n  return \"<div style='padding:12px;border:1px solid var(--line);border-radius:8px;background:#fafbfd;text-align:center'>\"\n    + \"<div style='color:var(--faint);font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase'>\" + label + \"</div>\"\n    + \"<div style='font-size:24px;font-weight:720;color:\" + color + \";margin-top:4px'>\" + value + \"</div>\"\n    + \"</div>\";\n}\n\nfunction openDataInspectorDirect() {\n  var allRows = sf.getAllRows();\n  var visibleRows = sf.getVisibleRows();\n  var sheet = sf.currentSheet();\n  if (!sheet) {\n    sf.openModal({\n      title: \"Data Inspector\",\n      content: \"<p style='color:var(--muted);font-size:13px'>No sheet loaded. Import a file first.</p>\",\n      buttons: [{ label: \"OK\", type: \"primary\" }]\n    });\n    return;\n  }\n  var headers = sheet.headers || [];\n  var colCount = headers.length;\n  var hiddenCount = allRows.length - visibleRows.length;\n  var headerHtml = \"\";\n  if (headers.length > 0) {\n    headerHtml = \"<div style='display:flex;flex-wrap:wrap;gap:4px;margin-bottom:16px'>\";\n    for (var h = 0; h < headers.length; h++) {\n      headerHtml += \"<span style='display:inline-flex;align-items:center;gap:4px;padding:4px 8px;border-radius:5px;background:#f1f5f9;font-size:10px;color:var(--ink-soft);font-weight:600'>\"\n        + \"<span style='color:var(--faint);font-size:8px'>\" + (h + 1) + \"</span>\"\n        + sf.escapeHTML(headers[h]) + \"</span>\";\n    }\n    headerHtml += \"</div>\";\n  }\n  var previewRows = allRows.slice(0, 5);\n  var previewHtml = \"\";\n  if (previewRows.length > 0) {\n    previewHtml = \"<div style='border:1px solid var(--line);border-radius:6px;overflow:hidden;margin-bottom:12px'>\";\n    for (var p = 0; p < previewRows.length; p++) {\n      var row = previewRows[p];\n      var cells = row.values.map(function (v) { return sf.escapeHTML(sf.valueToString(v)); }).join(\" \\u00b7 \");\n      previewHtml += \"<div style='display:flex;border-top:1px solid var(--line);font-size:10px'>\"\n        + \"<span style='min-width:28px;padding:5px 6px;background:#fafbfd;color:var(--faint);font-weight:600;border-right:1px solid var(--line);text-align:center'>\" + (row.sourceRowNumber || \"?\") + \"</span>\"\n        + \"<span style='flex:1;padding:5px 8px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>\" + cells + \"</span>\"\n        + \"<span style='padding:5px 8px;color:\" + (row.hidden ? \"var(--faint)\" : \"var(--green)\") + \";font-weight:600'>\" + (row.hidden ? \"Hidden\" : \"Visible\") + \"</span>\"\n        + \"</div>\";\n    }\n    previewHtml += \"</div>\";\n  }\n  var html = \"<div style='font-family:inherit'>\"\n    + \"<div style='display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;margin-bottom:16px'>\"\n    + statBox(\"Rows\", allRows.length, \"var(--ink)\")\n    + statBox(\"Visible\", visibleRows.length, \"var(--green)\")\n    + statBox(\"Hidden\", hiddenCount, \"var(--faint)\")\n    + statBox(\"Columns\", colCount, \"var(--violet)\")\n    + \"</div>\"\n    + \"<h4 style='margin:0 0 6px;font-size:12px;font-weight:700;color:var(--ink)'>Columns</h4>\"\n    + headerHtml\n    + \"<h4 style='margin:0 0 6px;font-size:12px;font-weight:700;color:var(--ink)'>First 5 rows</h4>\"\n    + previewHtml\n    + \"<p style='margin:0;color:var(--faint);font-size:10px'>Queried via sf.getAllRows(), sf.getVisibleRows(), sf.currentSheet()</p>\"\n    + \"</div>\";\n  sf.openModal({\n    title: \"Data Inspector\",\n    content: html,\n    width: 600,\n    buttons: [{ label: \"Close\", type: \"primary\" }]\n  });\n}\n"
  }
}